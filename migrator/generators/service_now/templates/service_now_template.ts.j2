{% import "helpers.ts.j2" as helper -%}
import "@servicenow/sdk/global";
import {
    {%- if 'Table' in used_column_types %}
    Table,
    {%- endif %}
    {%- if 'StringColumn' in used_column_types %}
    StringColumn,
    {%- endif %}
    {%- if 'IntegerColumn' in used_column_types %}
    IntegerColumn,
    {%- endif %}
    {%- if 'ChoiceColumn' in used_column_types %}
    ChoiceColumn,
    {%- endif %}
    {%- if 'ReferenceColumn' in used_column_types %}
    ReferenceColumn,
    {%- endif %}
    {%- if 'DateColumn' in used_column_types %}
    DateColumn,
    {%- endif %}
    {%- if 'DateTimeColumn' in used_column_types %}
    DateTimeColumn,
    {%- endif %}
    {%- if 'EmailColumn' in used_column_types %}
    EmailColumn,
    {%- endif %}
    {%- if 'BooleanColumn' in used_column_types %}
    BooleanColumn,
    {%- endif %}
    {%- if 'DecimalColumn' in used_column_types %}
    DecimalColumn,
    {%- endif %}
    {%- if 'UrlColumn' in used_column_types %}
    UrlColumn,
    {%- endif %}
    {%- if 'HtmlColumn' in used_column_types %}
    HtmlColumn,
    {%- endif %}
    {%- if 'Record' in used_column_types %}
    Record,
    {%- endif %}
} from '@servicenow/sdk/core';

{# Generate Enum definitions if any exist #}
{%- if enumerations %}

// --- ENUMERATIONS ---
{%- for enum in enumerations %}

/**
 * {{ enum.name }} Enumeration
 */
export const {{ enum.name | lower }}_choices = {
    {%- for literal in enum.literals %}
    {{ literal.name }}: '{{ literal.name }}',
    {%- endfor %}
} as const;
{%- endfor %}
{%- endif %}

{# Generate Table Definitions #}

// --- TABLES ---
{%- for class in classes %}

/**
 * {{ get_display_name(class.name) }}
 */
export const {{ get_table_name(class.name) }} = Table({
    name: '{{ get_table_name(class.name) }}',
    label: '{{ get_display_name(class.name) }}',
    display: 'name',
    extensible: true,
    allowWebServiceAccess: true,
    {%- if class.parents() %}
    extends: '{{ get_table_name(class.parents()[0].name) }}',
    {%- endif %}
    schema: {
        {%- for attribute in class.attributes %}
        {%- if attribute.type.__class__.__name__ == 'Enumeration' %}
{{ helper.render_choice_column(attribute) }},
        {%- else %}
{{ helper.render_simple_column(attribute) }},
        {%- endif %}
        {%- endfor %}
        {%- for ref in references.get(class.name, []) %}
        {%- if ref.multiplicity_max == 1 %}
        {{ ref.property_name }}: ReferenceColumn({
            referenceTable: '{{ ref.reference_table }}',
            label: '{{ ref.property_name | replace('_', ' ') | title }}',
        }),
        {%- endif %}
        {%- endfor %}
    },
});
{%- endfor %}

{# Generate Related Lists for associations #}
{%- if associations %}

// --- RELATED LISTS ---
{%- for association in associations if association.ends | length == 2 %}
{%- set ends = association.ends | list %}
{#- Pick the "one" end and the "many" end by multiplicity, never by
    position: association.ends is an unordered set, so ends[0]/ends[1]
    can swap between runs on the exact same model. #}
{%- set one_end = ends[0] if ends[0].multiplicity.max == 1 else ends[1] %}
{%- set many_end = ends[1] if ends[0].multiplicity.max == 1 else ends[0] %}
{%- if one_end.multiplicity.max == 1 and many_end.multiplicity.max > 1 %}
{%- set parent_table = get_table_name(one_end.type.name) %}
{%- set child_table = get_table_name(many_end.type.name) %}
{#- The FK column that get_reference_columns() places on the child table
    is named after one_end (see get_reference_columns): keep both in sync. #}
{%- set fk_field = one_end.name %}
{%- set rl_id = parent_table ~ '_' ~ child_table ~ '_related_list' %}

/**
 * Related List on {{ parent_table }}: {{ child_table }} records (via {{ child_table }}.{{ fk_field }})
 */
const {{ rl_id }} = Record({
    $id: Now.ID['{{ rl_id }}'],
    table: 'sys_ui_related_list',
    data: {
        name: '{{ parent_table }}',
        view: 'Default view',
    },
});

Record({
    $id: Now.ID['{{ rl_id }}_entry'],
    table: 'sys_ui_related_list_entry',
    data: {
        list_id: {{ rl_id }},
        position: 0,
        related_list: '{{ child_table }}.{{ fk_field }}',
    },
});
{%- endif %}
{%- endfor %}
{%- endif %}
